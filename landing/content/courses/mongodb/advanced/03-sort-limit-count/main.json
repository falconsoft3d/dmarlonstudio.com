// The three best customers by money spent (cancelled excluded)
{"collection": "orders", "aggregate": [
  {"$match": {"status": {"$ne": "cancelled"}}},
  {"$group": {"_id": "$customer_id", "spent": {"$sum": "$total"}}},
  {"$sort": {"spent": -1}},
  {"$limit": 3}
]}

// $count: how many documents reach this stage
{"collection": "orders", "aggregate": [
  {"$match": {"total": {"$gt": 12}}},
  {"$count": "big_orders"}
]}

// $sortByCount = $group by a value + $sum 1 + $sort descending
{"collection": "customers", "aggregate": [
  {"$sortByCount": "$city"},
  {"$sort": {"count": -1, "_id": 1}}
]}
