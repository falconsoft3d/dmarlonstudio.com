// $in: the status is one of the list
{"collection": "orders", "find": {"status": {"$in": ["paid", "new"]}},
 "projection": {"status": 1, "total": 1}, "sort": {"_id": 1}}

// $nin: none of the list
{"collection": "customers", "find": {"city": {"$nin": ["Madrid", "Seville"]}},
 "projection": {"name": 1, "city": 1}, "sort": {"_id": 1}}

// Several keys in one filter are an implicit $and
{"collection": "products", "find": {"category_id": 4, "active": true},
 "projection": {"name": 1}, "sort": {"_id": 1}}

// $or: any of the conditions
{"collection": "products",
 "find": {"$or": [{"stock": 0}, {"price": {"$gt": 5}}]},
 "projection": {"_id": 0, "name": 1, "price": 1, "stock": 1},
 "sort": {"price": -1}}
