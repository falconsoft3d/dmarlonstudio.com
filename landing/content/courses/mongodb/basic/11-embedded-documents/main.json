// An order carries its lines inside: an array of documents
{"collection": "orders", "find": {"_id": 2},
 "projection": {"customer_id": 1, "items": 1}}

// Dot notation reaches into the array: orders with Espresso beans (4)
{"collection": "orders", "find": {"items.product_id": 4},
 "projection": {"customer_id": 1, "total": 1}, "sort": {"_id": 1}}

// And projects only part of each line
{"collection": "orders", "find": {"_id": 1},
 "projection": {"items.product_id": 1, "items.qty": 1}}

// Orders with a line of 4 or more units
{"collection": "orders", "find": {"items.qty": {"$gte": 4}},
 "projection": {"_id": 1, "customer_id": 1, "ordered": 1, "total": 1},
 "sort": {"_id": 1}}
