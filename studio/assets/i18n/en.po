msgid "Arrastre para dibujar un marco o elija un tamaño de dispositivo a la izquierda"
msgstr "Drag to draw a frame or pick a device size on the left"

#: lib/code/tk_showcase_pascal_opend.dart
msgid "Arrastre para dibujar · Mayús: en ángulos de 45°"
msgstr "Drag to draw · Shift: at 45° angles"

#: lib/code/tk_showcase_pascal_opend.dart
