msgid "Comienzo"
msgstr "Start"

#: lib/code/tk_showcase_pascal_opend.dart
msgid "Componente"
msgstr "Component"

#: lib/code/tk_showcase_pascal_opend.dart
msgid "Componente creado: está en la Biblioteca"
msgstr "Component created: it is in the Library"

#: lib/code/tk_showcase_pascal_opend.dart
msgid "Componente principal: sus instancias lo siguen"
msgstr "Main component: its instances follow it"

#: lib/code/tk_showcase_pascal_opend.dart
msgid "Conectado con «%s»"
msgstr "Connected to “%s”"

#: lib/code/tk_showcase_pascal_opend.dart
msgid "Consejo: arrastre el círculo + de la capa hasta otro marco para conectarlos."
msgstr "Tip: drag the layer's + circle to another frame to connect them."

#: lib/code/tk_showcase_pascal_opend.dart
msgid "Copiado"
msgstr "Copied"

#: lib/code/tk_showcase_pascal_opend.dart
msgid "Copiar como CSS"
msgstr "Copy as CSS"

