#: lib/code/tk_examples.dart
msgid ""
"# Código de la aplicación web: corre en el servidor, en Python. Cada evento\n"
"# del diseño es un método de esta clase; self.root es la página y\n"
"# self.<Nombre>, cada componente, con las llamadas de tkinter. También\n"
"# self.value(\"Nombre\"), self.value(\"Nombre\", valor) y self.notify(texto).\n"
"# Ya existen en __init__; el evento «Al abrir» se ejecuta después de él."
msgstr ""
"# Web app code: it runs on the server, in Python. Each event of the\n"
"# design is a method of this class; self.root is the page and\n"
"# self.<Name> each component, with the tkinter calls. Also\n"
"# self.value(\"Name\"), self.value(\"Name\", value) and self.notify(text).\n"
"# They already exist in __init__; the \"On open\" event runs after it."

#: lib/code/tk_examples.dart
msgid ""
"# Código de la ventana: cada evento del diseño es un método de esta clase.\n"
"# self.root es la ventana y self.<Nombre>, cada componente: ya existen en\n"
"# __init__, y el evento «Al abrir» de la ventana se ejecuta después de él."
msgstr ""
"# Window code: each event of the design is a method of this class.\n"
"# self.root is the window and self.<Name> each component: they already exist\n"
"# in __init__, and the window's \"On open\" event runs after it."

