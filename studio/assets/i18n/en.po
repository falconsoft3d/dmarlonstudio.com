msgid "Acerca de OpenD++"
msgstr "About OpenD++"

#: lib/code/tk_showcase_pascal_opend.dart
msgid "Agrupar"
msgstr "Group"

#: lib/code/tk_showcase_pascal_opend.dart
msgid "Ancho automático"
msgstr "Auto width"

