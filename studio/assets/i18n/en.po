msgid "Copiar el código"
msgstr "Copy the code"

#: lib/code/tk_showcase_pascal_opend.dart
msgid "Copiar la plantilla JSON para la IA"
msgstr "Copy the JSON template for the AI"

#: lib/code/tk_showcase_pascal_opend.dart
msgid "Copiar la selección como JSON"
msgstr "Copy the selection as JSON"

#: lib/code/tk_showcase_pascal_opend.dart
msgid "Crear un componente"
msgstr "Create a component"

#: lib/code/tk_showcase_pascal_opend.dart
